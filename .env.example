# Copy this file to .env and fill in local or Azure values.
# Never commit .env or real secrets.

FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-to-another-long-random-string

# Local default: SQLite file in instance/
# Azure MySQL example:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/soc_ai?ssl_ca=/path/to/DigiCertGlobalRootCA.crt.pem
DATABASE_URL=sqlite:///soc_ai.db

# Cookie/JWT
JWT_COOKIE_SECURE=false
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Account lockout
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Demo password-reset tokens appear in API responses only when true
EXPOSE_RESET_TOKEN=true

# Optional Azure Blob (not required for local)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=security-logs
